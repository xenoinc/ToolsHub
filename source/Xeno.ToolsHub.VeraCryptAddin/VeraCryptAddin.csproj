<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>Xeno.ToolsHub.VeraCryptAddin</RootNamespace>
    <AssemblyName>VeraCryptAddin</AssemblyName>
    <OutputPath>..\..\output\</OutputPath>
    <CodeAnalysisRuleSet>..\stylecop.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Xeno.ToolsHub\Xeno.ToolsHub.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="VeraCrypt.addin.xml" />
    <EmbeddedResource Include="VeraCrypt.addin.xml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Mono.Addins" Version="1.4.1" />
    <PackageReference Include="StyleCop.Analyzers" Version="1.1.118" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.8" />
  </ItemGroup>
</Project>
