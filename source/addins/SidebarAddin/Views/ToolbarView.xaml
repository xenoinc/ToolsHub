<Window x:Class="Xeno.Dockzi.SidebarAddin.Views.ToolbarView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sidebar launcher"
        Width="80"
        Height="220"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="{Binding OnTop}"
        Opacity="{Binding Opacity}"
        WindowStartupLocation="Manual"
        AllowDrop="True"
        PreviewDragEnter="OnDragOver"
        PreviewDragOver="OnDragOver"
        PreviewDrop="OnDrop">
  <Window.Resources>
    <Style x:Key="LauncherButton" TargetType="Button">
      <Setter Property="Width" Value="64" />
      <Setter Property="Height" Value="64" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="Tile"
                      Background="{TemplateBinding Background}"
                      CornerRadius="12"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="1">
                <Image x:Name="Icon"
                       Source="{Binding Image}"
                       Width="40"
                       Height="40"
                       RenderTransformOrigin="0.5,0.5"
                       RenderOptions.BitmapScalingMode="HighQuality">
                  <Image.RenderTransform>
                    <ScaleTransform />
                  </Image.RenderTransform>
                </Image>
              </Border>
              <Ellipse Width="5"
                       Height="5"
                       Fill="#FFE5F2FF"
                       VerticalAlignment="Bottom"
                       Margin="0,0,0,3">
                <Ellipse.Style>
                  <Style TargetType="Ellipse">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsRunning}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Ellipse.Style>
              </Ellipse>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Tile" Property="Background" Value="#354E657C" />
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Icon"
                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                       To="1.2"
                                       Duration="0:0:0.12" />
                      <DoubleAnimation Storyboard.TargetName="Icon"
                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                       To="1.2"
                                       Duration="0:0:0.12" />
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Icon"
                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                       To="1"
                                       Duration="0:0:0.12" />
                      <DoubleAnimation Storyboard.TargetName="Icon"
                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                       To="1"
                                       Duration="0:0:0.12" />
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Tile" Property="BorderBrush" Value="#A0B6DBFF" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Tile" Property="Background" Value="#65728DA8" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="AddLauncherStyle" TargetType="Button">
      <Setter Property="Width" Value="64" />
      <Setter Property="Height" Value="64" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="AddTile" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="12">
              <Border Width="34" Height="34" CornerRadius="17" BorderThickness="1"
                      BorderBrush="#668ACBFF" Background="#203E5674">
                <Path Data="M 8,0 L 8,16 M 0,8 L 16,8" Stroke="#C5E3FF" StrokeThickness="2"
                      Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="AddTile" Property="Background" Value="#354E657C" /></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="AddTile" Property="BorderBrush" Value="#A0B6DBFF" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid x:Name="DockRoot" ClipToBounds="True">
    <Border x:Name="DockSurface"
            Background="#F0202632"
            BorderBrush="#607E8BA0"
            BorderThickness="1"
            CornerRadius="16"
            Padding="7">
      <Border.ContextMenu>
        <ContextMenu>
          <MenuItem Header="Add launcher…" Click="OnAddLauncher" />
          <Separator />
          <MenuItem Header="Sidebar settings…" Click="OnOpenSettings" />
        </ContextMenu>
      </Border.ContextMenu>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel LastChildFill="True">
          <Button x:Name="AddLauncherButton" DockPanel.Dock="Bottom" Style="{StaticResource AddLauncherStyle}"
                  AllowDrop="True" AutomationProperties.Name="Add launcher" Click="OnAddLauncher"
                  ToolTip="Add launcher: click to browse or drop apps and shortcuts here" />
          <ScrollViewer x:Name="LauncherScroll"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Hidden"
                        CanContentScroll="False"
                        PanningMode="Both"
                        PreviewMouseWheel="OnMouseWheel">
            <Grid>
              <ItemsControl x:Name="Launchers" ItemsSource="{Binding Items}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="{Binding Orientation}" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Style="{StaticResource LauncherButton}"
                            ToolTip="{Binding Title}"
                            AutomationProperties.Name="{Binding Title}"
                            Click="OnLaunch"
                            PreviewMouseLeftButtonDown="OnItemMouseDown"
                            PreviewMouseMove="OnItemMouseMove">
                      <Button.ContextMenu>
                        <ContextMenu>
                          <MenuItem Header="Remove from sidebar" Click="OnRemoveLauncher" />
                          <MenuItem Header="Add launcher…" Click="OnAddLauncher" />
                          <Separator />
                          <MenuItem Header="Sidebar settings…" Click="OnOpenSettings" />
                        </ContextMenu>
                      </Button.ContextMenu>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="Drop apps here" Foreground="#AEBFD2" TextWrapping="Wrap" TextAlignment="Center"
                         VerticalAlignment="Center" Margin="6" IsHitTestVisible="False">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Items.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Grid>
          </ScrollViewer>
        </DockPanel>
        <TextBlock Grid.Row="1"
                   Text="{Binding Error}"
                   Foreground="#FFE2AE"
                   TextWrapping="Wrap"
                   FontSize="11"
                   MaxHeight="100"
                   ToolTip="{Binding Error}">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Visible" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Error}" Value="{x:Null}">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </Grid>
    </Border>
    <Border x:Name="EdgeGrip"
            Width="3"
            HorizontalAlignment="Left"
            Background="#B08ACBFF"
            CornerRadius="1"
            Visibility="Collapsed" />
    <Canvas x:Name="DragOverlay"
            IsHitTestVisible="False"
            ClipToBounds="True">
      <Border x:Name="InsertionMarker"
              Panel.ZIndex="1"
              Background="#FF8ACBFF"
              CornerRadius="2"
              Visibility="Collapsed" />
      <Border x:Name="DragPreview"
              Width="56"
              Height="56"
              CornerRadius="12"
              Background="#E83B4C60"
              BorderBrush="#B08ACBFF"
              BorderThickness="1"
              Opacity="0.95"
              Visibility="Collapsed">
        <Border.Effect>
          <DropShadowEffect BlurRadius="10"
                            ShadowDepth="2"
                            Opacity="0.5" />
        </Border.Effect>
        <Image x:Name="DraggedIcon"
               Width="44"
               Height="44"
               RenderOptions.BitmapScalingMode="HighQuality" />
      </Border>
    </Canvas>
  </Grid>
</Window>
