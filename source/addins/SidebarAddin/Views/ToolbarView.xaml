<Window x:Class="Xeno.ToolsHub.SidebarAddin.Views.ToolbarView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sidebar launcher" Width="80" Height="220"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" ShowActivated="False"
        Topmost="{Binding OnTop}" Opacity="{Binding Opacity}"
        WindowStartupLocation="Manual" AllowDrop="True"
        PreviewDragEnter="OnDragOver" PreviewDragOver="OnDragOver" PreviewDrop="OnDrop">
  <Window.Resources>
    <Style x:Key="LauncherButton" TargetType="Button">
      <Setter Property="Width" Value="64" />
      <Setter Property="Height" Value="64" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Tile" Background="{TemplateBinding Background}" CornerRadius="12"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
              <Image x:Name="Icon" Source="{Binding Image}" Width="40" Height="40"
                     RenderTransformOrigin="0.5,0.5" RenderOptions.BitmapScalingMode="HighQuality">
                <Image.RenderTransform><ScaleTransform /></Image.RenderTransform>
              </Image>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Tile" Property="Background" Value="#354E657C" />
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Icon" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.2" Duration="0:0:0.12" />
                      <DoubleAnimation Storyboard.TargetName="Icon" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.2" Duration="0:0:0.12" />
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Icon" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.12" />
                      <DoubleAnimation Storyboard.TargetName="Icon" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.12" />
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Tile" Property="BorderBrush" Value="#A0B6DBFF" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Tile" Property="Background" Value="#65728DA8" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid x:Name="DockRoot">
  <Border x:Name="DockSurface" Background="#F0202632" BorderBrush="#607E8BA0"
          BorderThickness="1" CornerRadius="16" Padding="7">
    <Border.ContextMenu>
      <ContextMenu><MenuItem Header="Add launcher…" Click="OnAddLauncher" /></ContextMenu>
    </Border.ContextMenu>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <ScrollViewer x:Name="LauncherScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden"
                    CanContentScroll="False" PanningMode="Both" PreviewMouseWheel="OnMouseWheel">
        <ItemsControl x:Name="Launchers" ItemsSource="{Binding Items}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="{Binding Orientation}" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Style="{StaticResource LauncherButton}" ToolTip="{Binding Title}"
                      AutomationProperties.Name="{Binding Title}" Click="OnLaunch"
                      PreviewMouseLeftButtonDown="OnItemMouseDown" PreviewMouseMove="OnItemMouseMove">
                <Button.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Remove from sidebar" Click="OnRemoveLauncher" />
                    <MenuItem Header="Add launcher…" Click="OnAddLauncher" />
                  </ContextMenu>
                </Button.ContextMenu>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      <Button x:Name="EmptyHint" Background="Transparent" BorderThickness="0" Foreground="#D1DBE7"
              Padding="6" Cursor="Hand" Click="OnAddLauncher" ToolTip="Drop apps, files or Windows shortcuts here, or click to browse">
        <Button.Style>
          <Style TargetType="Button">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding Items.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
            </Style.Triggers>
          </Style>
        </Button.Style>
        <TextBlock Text="+&#10;Drop apps or shortcuts here" TextWrapping="Wrap" TextAlignment="Center" />
      </Button>
      <TextBlock Grid.Row="1" Text="{Binding Error}" Foreground="#FFE2AE" TextWrapping="Wrap"
                 FontSize="11" MaxHeight="100" ToolTip="{Binding Error}">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding Error}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
    </Grid>
  </Border>
    <Canvas x:Name="DragOverlay" IsHitTestVisible="False" ClipToBounds="True">
      <Border x:Name="InsertionMarker" Panel.ZIndex="1" Background="#FF8ACBFF" CornerRadius="2" Visibility="Collapsed" />
      <Border x:Name="DragPreview" Width="56" Height="56" CornerRadius="12" Background="#E83B4C60"
              BorderBrush="#B08ACBFF" BorderThickness="1" Opacity="0.95" Visibility="Collapsed">
        <Border.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.5" /></Border.Effect>
        <Image x:Name="DraggedIcon" Width="44" Height="44" RenderOptions.BitmapScalingMode="HighQuality" />
      </Border>
    </Canvas>
  </Grid>
</Window>
