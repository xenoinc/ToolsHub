<?xml version="1.0" encoding="utf-8" ?>
<!--
Copyright Xeno Innovations, Inc. 2018
 * Date:    2018-10-03
 * Author:  Damian Suess
 * File:    SampleXmlAddin.addin
 * Description:
 *  Sample add-in using an XML manifest
 *
 *  Note: keep namespace in the root node blank, but fully define in dependencies.
-->
<Addin namespace=""
       id="ExternalSampleXmlAddin"
       version="1.0"
       name="Sample External XML Add-in"
       author="Damian Suess"
       copyright="Xeno Innovations, Inc. 2018-2019"
       description="Quick sample external add-in project."
       category="Sample"
       defaultEnabled="false"
       isRoot="false">
  <!-- Do not include (bug in mono.addins): xmlns="https://github.com/mono/mono-addins/MonoAddins.xsd" -->

  <Runtime>
    <Import assembly="SampleXmlAddin.dll" />
  </Runtime>

  <Dependencies>
    <Addin id="Xeno.Dockzi" version="0.3" />
  </Dependencies>

  <Extension path="/Dockzi/OnStartup">
    <OnStartupAddin type="Xeno.Dockzi.SampleXmlAddin.Handlers.OnStartHandler" />
  </Extension>

  <Extension path="/Dockzi/Utility">
    <UtilityAddin type="Xeno.Dockzi.SampleXmlAddin.Handlers.UtilityHandler" />
  </Extension>

  <Extension path="/Dockzi/PreferencePage">
    <PreferencePageAddin type="Xeno.Dockzi.SampleXmlAddin.Handlers.PreferenceHandler" />
  </Extension>

  <!--
  <Extension Path="/Dockzi/SystemTray">
    <SysTrayAddin type="Xeno.Dockzi.SampleXmlAddin.SysTrayHandlers.Handlers.SysTrayHandler" />
  </Extension>
  -->
</Addin>
